{
    "name": "goldnead/statamic-brand-context",
    "description": "Optional multi-brand (multi-tenant) foundation for Statamic addons. Single-brand by default, multi-brand behind a feature flag.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "multi-tenant",
        "multi-brand",
        "brand"
    ],
    "authors": [
        {
            "name": "Adrian Goldner",
            "email": "info@adriangoldner.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-brand-context/issues",
        "source": "https://github.com/goldnead/statamic-brand-context"
    },
    "require": {
        "php": "^8.2",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^12.40|^13.0",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\BrandContext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\BrandContext\\Tests\\": "tests/",
            "Goldnead\\BrandContext\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Brand Context",
            "slug": "brand-context",
            "description": "Optional multi-brand foundation for Statamic addons.",
            "url": "https://github.com/goldnead/statamic-brand-context",
            "developer": "Adrian Goldner",
            "developer-url": "https://adriangoldner.com"
        },
        "laravel": {
            "providers": [
                "Goldnead\\BrandContext\\ServiceProvider"
            ],
            "aliases": {
                "BrandContext": "Goldnead\\BrandContext\\Facades\\BrandContext"
            }
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "test:mysql": [
            "@php vendor/bin/pest -c phpunit.mysql.xml"
        ],
        "lint": [
            "@php vendor/bin/pint"
        ],
        "lint:test": [
            "@php vendor/bin/pint --test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "composer/installers": true,
            "php-http/discovery": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
