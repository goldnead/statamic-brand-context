# Everything a site installing this package does not need.
# Without this, every consumer downloads the 65-test suite, the MySQL config,
# the Vite sources, the listing artwork and the CI definitions along with the
# package.

/.github            export-ignore
/tests              export-ignore
/art                export-ignore
/screenshots        export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml        export-ignore
/phpunit.mysql.xml  export-ignore
/pint.json          export-ignore
/phpstan.neon       export-ignore
/phpstan-baseline.neon export-ignore
/addon-lint.json    export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/vite.config.js     export-ignore
/vitest.config.js   export-ignore
/resources/js       export-ignore

# Deliberately kept: /resources/dist (the built CP bundle consumers load),
# /resources/lang, /config, /database, /routes, /src,
# README.md, CHANGELOG.md, LICENSE.md.
